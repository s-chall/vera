# Copy to .env.local. Local Supabase defaults from `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Prefer the key printed by `supabase status`. Demo JWT below works with older local stacks.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Newer CLI publishable key (if status shows sb_publishable_…):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Hosted project: publishable key only — never service_role in the browser.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Bitcoin Total Pool — Signet-first for Bitcoin hackathons
BITCOIN_NETWORK=signet
BITCOIN_POOL_ADDRESS=
NEXT_PUBLIC_BITCOIN_POOL_ADDRESS=
BITCOIN_MEMPOOL_API=https://mempool.space/signet/api
BITCOIN_USD_HINT=

# Chat — local Maple / Ollama (never defaults to cloud OpenAI)
MAPLE_BASE_URL=
MAPLE_API_KEY=
MAPLE_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional fiat on-ramp
NEXT_PUBLIC_MOONPAY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:4174

# Optional, for the verification test. A real CNP/cédula pair from the register.
# Keep this out of version control — put it in .env.test (gitignored).
# VERA_TEST_CNP=
# VERA_TEST_CEDULA=
