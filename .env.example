# Copy to .env.local. These are the defaults for the local stack started by
# `npx supabase start`; the key is the standard local development key, identical
# on every machine and not a secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# For a hosted project, replace both. Only ever the publishable key here, never
# the service_role key: this file ships to the browser.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Optional, for the verification test. A real CNP/cédula pair from the register.
# Keep this out of version control: it is a real person's national ID.
# Put it in .env.test (gitignored), not here.
# VERA_TEST_CNP=
# VERA_TEST_CEDULA=
